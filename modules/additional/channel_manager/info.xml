	<shortName>Channel Manager</shortName>
    <description>Channel Manager module for uHotelBooking script allows owners to efficiently manage the different online distribution channels that their property sells through.</description>
    <version>1.1.0</version>
    <creationDate>01/12/2016</creationDate>
    <lastChangedDate>04/10/2017</lastChangedDate>
    <author>ApPHP</author>
    <authorEmail>info@apphp.com</authorEmail>
    <authorUrl>http://www.apphp.com</authorUrl>
    <copyright>ApPHP</copyright>
    <license>Commercial</license>
    <manual></manual>
    <icon>images/channel_manager.png</icon>
    <moduleType>additional</moduleType>
    <code>channel_manager</code>
    <files>
