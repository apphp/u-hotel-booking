			<filename installationPath="admin/modules/">mod_channel_manager_rooms.php</filename>
			<filename installationPath="admin/modules/">mod_channel_manager_settings.php</filename>
		</lib>
		<filename>.htaccess</filename>
		<filename>listener.php</filename>
		<filename>sender.php</filename>
		<filename>cm_mod_room_availability.php</filename>
		<filename>cm_mod_room_prices.php</filename>
		<filename>cm_reservation_notification.php</filename>
		<filename>CHANGELOG</filename>
		<filename>INSTALL</filename>
		<filename>README</filename>
		<filename>info.xml</filename>
