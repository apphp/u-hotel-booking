            <filename installationPath="include/classes/">PropertyExpenses.class.php</filename>
            <filename installationPath="include/classes/">PropertyInventory.class.php</filename>
            <filename installationPath="templates/admin/js/">propertymanagement.js</filename>
		</lib>
		<filename>.htaccess</filename>
		<filename>CHANGELOG</filename>
		<filename>INSTALL</filename>
		<filename>README</filename>
		<filename>info.xml</filename>
	</files>
